<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.awardie</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yudao-module-business</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        AwardIE 业务模块:竞赛/实验室/成果提交/审核流/成果库/模板/统计等全部业务域
        (芋道 system/infra 之外的自有模块,包路径 cn.iocoder.yudao.module.business,见 ADR-0003)
    </description>

    <dependencies>
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 跨模块:用户域(登录升级监听器需 AdminUserMapper;芋道 member/im/erp 同此先例) -->
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- scrypt 口令兼容(v2 存量 werkzeug scrypt 哈希校验;版本与 v2 一致) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-spring-boot-starter-security</artifactId>
        </dependency>
        <!-- spring-security-core:框架 starter 里是 provided(不传递),本模块登录升级监听器编译期需要 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- gRPC(批7:AI Worker 客户端;版本在 yudao-dependencies 统一管理) -->
        <!-- 用 netty-shaded 而非 grpc-netty:芋道自带 Netty 4.2,非 shaded 版会与之抢版本 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <!-- gRPC 生成物用 @javax.annotation.Generated(protoc 1.64 的输出形态);
             JDK11+ 移出了 javax.annotation,芋道用的是 jakarta 包,故显式补这个编译期依赖。
             纯 provided:运行期注解不存在也无影响,仅生成物源码需要它能编译。 -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.awardie</groupId>
            <artifactId>yudao-spring-boot-starter-excel</artifactId>
        </dependency>
    </dependencies>

    <!-- 批25 D-27:p3c-pmd 静态门禁(阿里 Java 规约,10 个 ali-* 规则集)。手动激活(-Pp3c),
         CI 后端 job 末尾执行。口径对齐本地 p3c 纪律:只对增量负责——failurePriority=2 表示
         仅优先级 1-2(强制级)失败构建,推荐级(3)只报不拦;生成代码(gRPC 桩,存量 457 条告警
         皆在桩内、非人工可修)整体排除。maven-pmd-plugin 必须钉在 3.21.2(内置 PMD 6.55.0):
         3.22+ 升到 PMD 7,p3c-pmd 2.1.1 不兼容 PMD 7,规则会加载失败。 -->
    <profiles>
        <profile>
            <id>p3c</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>3.21.2</version>
                        <configuration>
                            <printFailingErrors>true</printFailingErrors>
                            <failurePriority>2</failurePriority>
                            <includeTests>true</includeTests>
                            <excludes>
                                <exclude>**/framework/grpc/awardie/ai/AiServiceProto.java</exclude>
                                <exclude>**/framework/grpc/awardie/ai/AiServiceGrpc.java</exclude>
                            </excludes>
                            <rulesets>
                                <ruleset>rulesets/java/ali-comment.xml</ruleset>
                                <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
                                <ruleset>rulesets/java/ali-constant.xml</ruleset>
                                <ruleset>rulesets/java/ali-exception.xml</ruleset>
                                <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
                                <ruleset>rulesets/java/ali-naming.xml</ruleset>
                                <ruleset>rulesets/java/ali-oop.xml</ruleset>
                                <ruleset>rulesets/java/ali-orm.xml</ruleset>
                                <ruleset>rulesets/java/ali-other.xml</ruleset>
                                <ruleset>rulesets/java/ali-set.xml</ruleset>
                            </rulesets>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>com.alibaba.p3c</groupId>
                                <artifactId>p3c-pmd</artifactId>
                                <version>2.1.1</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>p3c-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pmd</goal>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
